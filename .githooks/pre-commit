#!/bin/sh
# Daedalus pre-commit hook: blocks personal info, local paths, secrets and
# design documents from being committed to this public repository.
# Enable once per clone with:  git config core.hooksPath .githooks

if command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v python >/dev/null 2>&1; then
    PY=python
else
    echo "pre-commit: Python 3 is needed for the hygiene check." >&2
    exit 1
fi

exec "$PY" "$(git rev-parse --show-toplevel)/scripts/hygiene/check_hygiene.py" --staged
