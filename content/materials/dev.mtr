/*
	GrizzTech4 prototype materials

	Grid textures for blocking out levels: the small squares are 16 units,
	the large ones 64 units. Generated by scripts/content/make_dev_content.py.
*/

textures/dev/grid_floor
{
	qer_editorimage	textures/dev/grid_floor.tga
	diffusemap		textures/dev/grid_floor.tga
	bumpmap			_flat
}

