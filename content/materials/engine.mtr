/*
	Daedalus engine materials

	Materials the engine itself looks up by name. They only use images the
	engine generates at startup, so a new project needs no texture files to run.
*/

// required for renderer startup
_default
{
	{
		map		_default
	}
}

_white
{
	{
		map		_white
	}
}

_black
{
	{
		map		_black
	}
}

// collision-only surface used for trace models
_tracemodel
{
	collision
}

// solid colour for menus and editor overlays
guiSolid
{
	{
		blend	blend
		colored
		map		_white
		clamp
	}
}

// console text (generated by scripts/content/make_font.py)
textures/bigchars
{
	{
		blend	blend
		maskDepth
		colored
		nopicmip
		linear
		map		textures/bigchars.tga
	}
}

// --------------------------------------------------------------------------
// Lights
// --------------------------------------------------------------------------

// round light with a smooth quadratic falloff
lights/defaultPointLight
{
	lightFalloffImage	_quadratic
	{
		forceHighQuality
		map		_white
		colored
		zeroClamp
	}
}

// projected light that stays bright almost all the way to its end
lights/defaultProjectedLight
{
	lightFalloffImage	_noFalloff
	{
		forceHighQuality
		map		_white
		colored
		zeroClamp
	}
}

// --------------------------------------------------------------------------
// Editor and tool surfaces
// --------------------------------------------------------------------------

// hidden faces that still seal the level
textures/common/caulk
{
	qer_editorimage	_cyan
	noshadows
	forceOpaque
}

// faces that are never drawn and never seal
textures/common/nodraw
{
	qer_editorimage	_cyan
	nodraw
	noshadows
	nonsolid
}

// marks the playable area for the level compiler; never drawn
textures/common/visportal
{
	qer_editorimage	_cyan
	areaportal
	noshadows
}

// invisible wall that blocks the player and AI
textures/common/clip
{
	qer_editorimage	_cyan
	nodraw
	noshadows
	playerclip
	monsterclip
}

// how the editor shows surfaces that are invisible in the game (caulk, clip, visportals)
editor/toolsurface
{
	noshadows
	translucent
	{
		blend	blend
		map		_white
		red		0.25
		green	0.75
		blue	0.85
		alpha	0.35
	}
}

// the editor's floor grid (textures/editor/floorgrid.tga, from scripts/content/make_dev_content.py)
editor/floorgrid
{
	noshadows
	translucent
	twoSided
	{
		blend	blend
		map		textures/editor/floorgrid.tga
		red		0.75
		green	0.8
		blue	0.9
	}
}

// the rest of the level while a piece is being edited in place: a flat, see-through ghost
editor/ghost
{
	noshadows
	translucent
	twoSided
	{
		blend	blend
		map		_white
		red		0.55
		green	0.58
		blue	0.65
		alpha	0.22
	}
}
