/***********************************************************************

main.script

Daedalus's main script. The game compiles it at startup, before any
level script. A project adds its own scripts by #including them below.

***********************************************************************/

// how many times a second scripts and game logic update
float GAME_FPS = 60.0f;

// script/daedalus_defs.script (shared constants) is included automatically
// at the top of every script file

// the default player's script object
#include "script/player.script"

// per-level scripts are #included by the map's own script, which the
// game loads automatically from maps/<mapname>.script when it exists
