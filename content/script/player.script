/***********************************************************************

player.script

Script object for the default player. The game code reads and writes
these fields every frame, so a project's own player script object must
declare all of them (it can add more), plus an init() function.

***********************************************************************/

object player
{
	// movement input and state, kept up to date by the game
	boolean		AI_FORWARD;
	boolean		AI_BACKWARD;
	boolean		AI_STRAFE_LEFT;
	boolean		AI_STRAFE_RIGHT;
	boolean		AI_RUN;
	boolean		AI_JUMP;
	boolean		AI_CROUCH;
	boolean		AI_ONGROUND;
	boolean		AI_ONLADDER;
	boolean		AI_HARDLANDING;
	boolean		AI_SOFTLANDING;
	boolean		AI_TURN_LEFT;
	boolean		AI_TURN_RIGHT;
	boolean		AI_TELEPORT;

	// combat state
	boolean		AI_ATTACK_HELD;
	boolean		AI_WEAPON_FIRED;
	boolean		AI_RELOAD;
	boolean		AI_PAIN;
	boolean		AI_DEAD;

	// runs once when the player spawns
	void		init();

	// states the game code switches the player into; empty until a project gives the player weapons
	void		RaiseWeapon();
	void		LowerWeapon();
	void		ReloadWeapon();
	void		EnterCinematic();
	void		ExitCinematic();
};

void player::init()
{
}

void player::RaiseWeapon()
{
}

void player::LowerWeapon()
{
}

void player::ReloadWeapon()
{
}

void player::EnterCinematic()
{
}

void player::ExitCinematic()
{
}
